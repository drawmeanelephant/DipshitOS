const zc = @import("zc");

const Color = enum {
    red,
    green,
    blue,
};

const Status = enum(u32) {
    ok = 10,
    pending = 20,
    err = 30,
};

fn color_weight(c: Color) u64 {
    return switch (c) {
        .red => 10,
        .green => 20,
        .blue => 30,
    };
}

fn is_terminal(s: Status) u64 {
    return switch (s) {
        Status.ok, Status.err => 1,
        Status.pending => 0,
    };
}

pub fn main() void {
    const c: Color = .green;
    const ci: u64 = @intFromEnum(c);
    if (ci == 1) {
        const c2: Color = @enumFromInt(2);
        if (c2 == Color.blue) {
            if (color_weight(c) == 20) {
                var st: Status = Status.pending;
                if (@intFromEnum(st) == 20) {
                    if (is_terminal(st) == 0) {
                        st = .ok;
                        if (is_terminal(st) == 1) {
                            zc.print("ok\n");
                            zc.exit(72);
                        }
                    }
                }
            }
        }
    }
    zc.exit(1);
}
