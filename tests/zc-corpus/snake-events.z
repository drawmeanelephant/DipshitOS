// EV.Z — ADR 0009 event decoding + key mapping (pure; no zc import).
// 16-byte event (LE): kind u16 @0, flags u16 @2, seq u32 @4, arg0 u32 @8
// (key HID usage / win id), arg1 u32 @12 (decoded ASCII). kind 1 = KEY_DOWN,
// 6 = WIN_FOCUS, 8 = WIN_CLOSE.

fn ev_kind(buf: [*]u8) u64 {
    const k0: u64 = @intCast(buf[0]);
    const k1: u64 = @intCast(buf[1]);
    return k0 | (k1 << 8);
}

fn ev_arg0(buf: [*]u8) u64 {
    const a0: u64 = @intCast(buf[8]);
    const a1: u64 = @intCast(buf[9]);
    const a2: u64 = @intCast(buf[10]);
    const a3: u64 = @intCast(buf[11]);
    return a0 | (a1 << 8) | (a2 << 16) | (a3 << 24);
}

fn ev_arg1(buf: [*]u8) u64 {
    const b0: u64 = @intCast(buf[12]);
    const b1: u64 = @intCast(buf[13]);
    const b2: u64 = @intCast(buf[14]);
    const b3: u64 = @intCast(buf[15]);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// Key (HID usage or ASCII) to direction: 0 up, 1 down, 2 left, 3 right,
// 4 = not a direction key. Arrows: up 0x52, down 0x51, left 0x50, right
// 0x4F. WASD: w 119, s 115, a 97, d 100.
fn dir_for(usage: u64, ascii: u64) u64 {
    if (usage == 0x52) {
        return 0;
    }
    if (ascii == 119) {
        return 0;
    }
    if (usage == 0x51) {
        return 1;
    }
    if (ascii == 115) {
        return 1;
    }
    if (usage == 0x50) {
        return 2;
    }
    if (ascii == 97) {
        return 2;
    }
    if (usage == 0x4F) {
        return 3;
    }
    if (ascii == 100) {
        return 3;
    }
    return 4;
}

// 1 when turning 180 degrees back into the body (caller ignores it).
fn blocked(new_dir: u64, cur: u64) u64 {
    if (new_dir == 0) {
        if (cur == 1) {
            return 1;
        }
    }
    if (new_dir == 1) {
        if (cur == 0) {
            return 1;
        }
    }
    if (new_dir == 2) {
        if (cur == 3) {
            return 1;
        }
    }
    if (new_dir == 3) {
        if (cur == 2) {
            return 1;
        }
    }
    return 0;
}