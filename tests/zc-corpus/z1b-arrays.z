const zc = @import("zc");

pub fn main() void {
    var buf: [8]u8 = undefined;
    var i: u64 = 0;
    while (i < 8) {
        buf[i] = 65 + i;
        i = i + 1;
    }
    zc.print_array(buf);
    var sum: u64 = 0;
    i = 0;
    while (i < 8) {
        sum = sum + buf[i];
        i = i + 1;
    }
    if (sum == 548) {
        zc.exit(0);
    } else {
        zc.exit(1);
    }
}
