// SLIB.Z — one game frame: advance, render, classify (the zc import
// stays in SNAKE.Z). State st: 0 idle, 1 focused-idle, 2 auto-start,
// 3 auto-moving, 4 human-moving. Returns 0 idle / 2 first auto move /
// 3 auto pace / 4 human pace. SNAKE.Z prints snake-move on 2, paces
// 0/4 by sleep(1), 2/3 by yield — auto-play runs to the wall in ONE
// quantum, never dependent on wake latency. Focus (st=1) just idles:
// only a real direction key starts human play; auto-start fires from
// any pre-start state after 8 idle frames.
fn step(st: *State, segs: [*]u64, wid: u64, gw: u64, gh: u64, cell: u64) u64 {
    st.fr = st.fr + 1;
    if (st.st < 2) {
        if (st.fr > 8) {
            st.st = 2;
        }
    }
    if (st.st >= 1) {
        const tv: u64 = next_head(st.d, st.hx, st.hy, gw, gh);
        if (tv == 0xFFFF) {
            st.ov = 1;
        }
        if (st.ov == 0) {
            if (tv == st.fd) {
                if (st.n < 40) {
                    st.n = st.n + 1;
                }
            }
            shift_body(segs, st.n);
            segs[0] = tv;
            st.hx = px(tv);
            st.hy = py(tv);
            if (hit_self(segs, st.n) == 1) {
                st.ov = 1;
            }
            if (st.ov == 0) {
                if (tv == st.fd) {
                    st.fd = place_food(segs, st.n, gw, gh, st.fr * 31 + st.n * 7919);
                }
            }
        }
    }
    _ = zc.win_fill(wid, 0, 0, gw * cell, gh * cell, 0x0B1220);
    if (st.fd != 0xFFFF) {
        _ = zc.win_fill(wid, px(st.fd) * cell, py(st.fd) * cell, cell, cell, 0xF43F5E);
    }
    var b: u64 = st.n;
    while (b > 1) {
        b = b - 1;
        _ = zc.win_fill(wid, px(segs[b]) * cell, py(segs[b]) * cell, cell, cell, 0x34D399);
    }
    _ = zc.win_fill(wid, px(segs[0]) * cell, py(segs[0]) * cell, cell, cell, 0xA7F3D0);
    _ = zc.win_present(wid);
    if (st.st == 3) { return 3; }
    if (st.st == 4) { return 4; }
    if (st.st == 2) { st.st = 3; return 2; }
    return 0;
}