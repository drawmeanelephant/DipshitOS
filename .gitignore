# --- Zig ---
.zig-cache/
zig-cache/
zig-out/
*.o

# --- SwiftPM ---
.build/
.swiftpm/

# --- Generated evidence & runtime state (never commit) ---
artifacts/*
!artifacts/.gitkeep

# Generated by tools/inventory-gates.sh. Never commit: the snapshot encodes
# the whole tools/ tree (line counts, fleet list, directory file counts), so
# every spec/tooling PR that committed it merge-conflicted with every other.
docs/gate-fleet-inventory.md

# --- Boris documentation build outputs (never commit) ---
dist/
public-site/
evidence/
.boris-pages-profile.json

# --- Local context engine (tools/ragshit) index ---
.ragshit/

# --- Disk images, firmware blobs, EFI binaries, debug files ---
*.img
*.fd
*.bin
*.efi
*.pdb
*.dSYM/
core

# --- Freebuff local state ---
.freebuff/

# --- Editors & OS noise ---
.DS_Store
.vscode/
.idea/
*.swp
*~
